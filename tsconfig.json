{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "types": [
      "node",
      "@wdio/globals/types",
      "expect-webdriverio",
      "@wdio/mocha-framework"
    ],
    "paths": {
      "@pages/*": ["./src/business/pages/*"],
      "@constants/*": ["./src/business/constants/*"],
      "@business-types/*": ["./src/business/types/*"],
      "@utils/*": ["./src/core/utils/*"]
    },
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/test/configs/wdio.conf.ts",
    "./src/test/specs/**/*.ts",
    "src/**/*.ts"
  ]
}
